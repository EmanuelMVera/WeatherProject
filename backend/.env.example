# --- Servidor ---
# Puerto local. En Render se define automáticamente.
PORT=5000
# development | production | test
NODE_ENV=development

# Orígenes permitidos por CORS, separados por comas y sin barra final.
# Obligatoria en producción. (ALLOWED_ORIGIN, en singular, sigue aceptándose como alias.)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Proxies delante del servidor (Render usa 1). Afecta la IP que ve el rate limit.
TRUST_PROXY=1

# --- Proveedor meteorológico (Open-Meteo) ---
# No requiere API key para uso no comercial. Sólo para el plan comercial:
# OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com/v1
# OPEN_METEO_API_KEY=

# --- Opcionales (valores por defecto) ---
# UPSTREAM_TIMEOUT_MS=8000
# WEATHER_CACHE_TTL_SECONDS=600
# ALERTS_CACHE_TTL_SECONDS=600
# CACHE_STALE_SECONDS=10800
# CACHE_MAX_ENTRIES=500
# RATE_LIMIT_MAX=300
