# URL pública del backend (sin barra final). Ej: https://buen-clima-api.onrender.com
# En desarrollo dejala vacía: Vite reenvía /api al backend local (ver DEV_API_PROXY_TARGET).
VITE_API_URL=

# URL pública del frontend, usada para canonical / Open Graph. Ej: https://buenclima.vercel.app
# Si queda vacía, esas etiquetas se omiten.
VITE_SITE_URL=

# Sólo desarrollo: a dónde reenvía Vite las llamadas a /api (por defecto http://localhost:5000).
# DEV_API_PROXY_TARGET=http://localhost:5000
